# Expo Go/dev server: automatically use the computer that served the app.
EXPO_PUBLIC_API_URL=auto
EXPO_PUBLIC_API_PORT=3000
EXPO_PUBLIC_FACE_ANALYSIS_API_URL=auto
EXPO_PUBLIC_FACE_ANALYSIS_API_PORT=8000

# For a standalone build, use a deployed URL or reachable LAN address instead.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# EXPO_PUBLIC_FACE_ANALYSIS_API_URL=http://192.168.1.10:8000

# Vercel web deployment:
# Set both public API URLs to the HTTPS URLs of their deployed services.
# EXPO_PUBLIC_API_URL=https://your-api.example.com
# EXPO_PUBLIC_FACE_ANALYSIS_API_URL=https://your-face-api.example.com

# Render web deployment:
# Set EXPO_PUBLIC_API_URL in the Render facefit-web service after deploying
# facefit-api. It must be the public HTTPS API URL, for example:
# EXPO_PUBLIC_API_URL=https://facefit-api.onrender.com
