PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=facefit
# Comma-separated origins. Use * only during local development.
CORS_ORIGIN=*
JWT_SECRET=replace_this_with_a_long_random_secret
FACE_ANALYSIS_URL=http://127.0.0.1:8000

# Render deployment:
# PORT is supplied by Render.
# Set DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME, CORS_ORIGIN,
# JWT_SECRET, and optional FACE_ANALYSIS_URL in the Render dashboard.
