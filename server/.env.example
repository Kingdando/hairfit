PORT=3000
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require
SUPABASE_DB_SSL=true
DB_POOL_SIZE=10
# Comma-separated origins. Use * only during local development.
CORS_ORIGIN=*
JWT_SECRET=replace_this_with_a_long_random_secret
FACE_ANALYSIS_INTERNAL_URL=https://your-face-analysis-service.example.com/api/face-analysis.php
GEMINI_API_KEY=your-gemini-api-key
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash

# Render deployment:
# PORT is supplied by Render.
# Set SUPABASE_DB_URL, CORS_ORIGIN, JWT_SECRET, FACE_ANALYSIS_INTERNAL_URL, and
# GEMINI_API_KEY in the Render dashboard.
