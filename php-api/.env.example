GEMINI_API_KEY=your-gemini-api-key
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash

# Supabase project URL and server-only service role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key

# Set this to keep signed-in face scan history JWT verification working.
JWT_SECRET=use-the-same-secret-as-the-existing-api

# Comma-separated origins for web builds, or * for local development.
CORS_ORIGIN=*
