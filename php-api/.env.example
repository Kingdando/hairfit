GEMINI_API_KEY=your-gemini-api-key
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash

# Set these to keep signed-in face scan history working.
JWT_SECRET=use-the-same-secret-as-the-existing-api
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=facefit
DB_USER=root
DB_PASSWORD=

# Comma-separated origins for web builds, or * for local development.
CORS_ORIGIN=*
